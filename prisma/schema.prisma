generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth Tables ───────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  phone         String?   @unique
  image         String?
  role              String    @default("EMERALD") // Abstract role per ISCE standards
  hasAcceptedTerms  Boolean   @default(false)
  termsAcceptedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  addresses     DeliveryAddress[]
  orders        Order[]
  transactions  Transaction[]
  notifications Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ─── Domain Tables ────────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("categories")
}

model DeliveryAddress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String   @default("Home")
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@map("delivery_addresses")
}

model PickupLocation {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  landmark          String?
  contactName       String?
  contactPhone      String?
  pickupInstructions String?
  isActive          Boolean           @default(true)
  logisticsProvider LogisticsProvider @default(INTERNAL)
  externalReference String?
  logisticsMetadata Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  orders Order[]

  @@map("pickup_locations")
}

model Product {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String        @unique
  description           String?
  images                String[]      @default([])
  videos                String[]      @default([])
  colors                String[]      @default([])
  sizes                 String[]      @default([])
  customFields          Json          @default("[]")
  weightKg              Float         @default(0) // Parcel weight in kilograms (0 = not set)
  originalCost          Int           // Source cost in kobo
  markupPrice           Int           // Selling price in kobo
  moq                   Int           @default(1)
  isPreorder            Boolean       @default(false)
  expectedProcurementAt DateTime?
  priceLockDays         Int           @default(60)
  categoryId            String?
  category              Category?     @relation(fields: [categoryId], references: [id])
  status                ProductStatus @default(AVAILABLE)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  orders Order[]

  @@map("products")
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
  DISCONTINUED
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId          String
  product            Product     @relation(fields: [productId], references: [id])
  deliveryMethod     DeliveryMethod @default(DELIVERY)
  addressId          String?
  deliveryAddress    DeliveryAddress? @relation(fields: [addressId], references: [id])
  pickupLocationId   String?
  pickupLocation     PickupLocation? @relation(fields: [pickupLocationId], references: [id])
  logisticsProvider  LogisticsProvider @default(INTERNAL)
  logisticsReference String?
  logisticsMetadata  Json?
  quantity           Int         @default(1)
  selectedColor      String?
  selectedSize       String?
  customSelections   Json        @default("{}")
  totalAmount        Int         // Locked price at order creation in kobo
  installmentMonths  Int         @default(3) // Duration the user wants to spread payments
  amountPaid         Int         @default(0)
  status             OrderStatus @default(PENDING)
  isDepositPaid      Boolean     @default(false)
  priceLocked        Boolean     @default(true)
  priceLockedAt      DateTime    @default(now())
  priceLockExpiresAt DateTime
  completedAt        DateTime?
  procuredAt         DateTime?
  deliveredAt        DateTime?
  riderName          String?
  riderPhone         String?
  trackingNote       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  transactions  Transaction[]
  notifications Notification[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PARTIAL
  PAID
  PROCURED
  DISPATCHED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum LogisticsProvider {
  INTERNAL
  SPEEDAF
}

model Transaction {
  id               String            @id @default(cuid())
  orderId          String
  order            Order             @relation(fields: [orderId], references: [id])
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  amount           Int               // in kobo
  type             TransactionType
  paystackRef      String            @unique
  idempotencyKey   String            @unique
  status           TransactionStatus @default(PENDING)
  paystackResponse Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([orderId])
  @@index([userId])
  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  INSTALLMENT
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?              @relation(fields: [orderId], references: [id])
  channel   NotificationChannel
  type      NotificationType
  message   String
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?
  readAt    DateTime?           // null = unread (in-app)
  createdAt DateTime            @default(now())

  @@index([userId])
  @@map("notifications")
}

enum NotificationChannel {
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationType {
  PAYMENT_RECEIVED
  DEPOSIT_CONFIRMED
  ORDER_FULLY_PAID
  ITEM_PROCURED
  OUT_FOR_DELIVERY
  DELIVERED
  PRICE_LOCK_WARNING
  ORDER_EXPIRED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model AdminAction {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@map("admin_actions")
}

model SystemSetting {
  key       String   @id
  value     String
  type      String   @default("string") // string | number | boolean
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
